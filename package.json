{
  "name": "chrome-x-not-brother",
  "version": "0.4.9",
  "private": true,
  "description": "A local-first Chrome extension that annotates and collects X relationship observations.",
  "homepage": "https://github.com/interjc/chrome-x-not-brother#readme",
  "bugs": {
    "url": "https://github.com/interjc/chrome-x-not-brother/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interjc/chrome-x-not-brother.git"
  },
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test",
    "validate:dist": "node scripts/validate-dist.mjs",
    "package": "node scripts/package.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "skills:validate": "node scripts/validate-skill.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "dexie": "4.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
